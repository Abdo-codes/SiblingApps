  "strings": {
    "moreApps.action.get": {
      "comment": "Button that shows the App Store page of an app",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحميل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get"
          }
        }
      }
    },
    "moreApps.action.open": {
      "comment": "Button that opens an installed app",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        }
      }
    },
    "moreApps.action.view": {
      "comment": "Button that shows the App Store page of an app for another device",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View"
          }
        }
      }
    },
    "moreApps.group.appleTV": {
      "comment": "Group of Apple TV apps",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأجهزة Apple TV"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Apple TV"
          }
        }
      }
    },
    "moreApps.group.mac": {
      "comment": "Group of Mac apps",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأجهزة Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Mac"
          }
        }
      }
    },
    "moreApps.group.otherDevices": {
      "comment": "Group of Apple TV and Mac apps",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأجهزة Apple TV و Mac"
