            "state": "translated",
            "value": "For Apple TV & Mac"
          }
        }
      }
    },
    "moreApps.group.thisDevice": {
      "comment": "Group of apps that run on this device",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأجهزة iPhone و iPad"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For iPhone & iPad"
          }
        }
      }
    },
    "moreApps.section.footer": {
      "comment": "Footer below the More Apps section",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من صُنع الفريق الصغير نفسه. جميعها مجانية للتجربة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made by the same small team. All free to try."
          }
        }
      }
    },
    "moreApps.section.title": {
      "comment": "Settings section header above the featured apps",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزيد من تطبيقاتنا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More apps by us"
          }
        }
      }
    },
    "moreApps.seeAll": {
      "comment": "Row that opens the full list of apps",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض كل التطبيقات"
